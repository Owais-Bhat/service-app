# Copy to .env and set to your backend's API origin (including /api).
# - Local dev on a physical device/emulator: use your dev machine's LAN IP,
#   e.g. http://192.168.1.20:5000/api (NOT localhost — the phone can't
#   resolve your machine's localhost).
# - Production: your deployed domain, e.g. https://app.example.com/api
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:5000/api
